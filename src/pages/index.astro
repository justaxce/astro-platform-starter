---
import Layout from '../layouts/Layout.astro';
import Markdown from '../components/Markdown.astro';

const explainer = `
Welcome to Jo1nTrX™ - where cutting-edge technology meets exceptional performance.

Our platform harnesses the power of modern web infrastructure to deliver lightning-fast, scalable applications with a stunning purple aesthetic. Experience the future of web development with streaming SSR, edge computing, and advanced caching strategies.

Join us on our journey to redefine what's possible on the web.
`;
---

<Layout title="Welcome to Jo1nTrX™">
    <h1 class="mb-10">Jo1nTrX™ Platform</h1>
    <Markdown content={explainer} class="mb-10 text-lg" />
    <p>
        <a href="/about" class="btn btn-lg sm:min-w-64">Learn More</a>
    </p>
</Layout>
