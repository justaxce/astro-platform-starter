---
import Layout from '../layouts/Layout.astro';
import Markdown from '../components/Markdown.astro';

const explainer = `
Jo1nTrX™ - Your Ultimate Multipurpose Discord Bot.

A powerful Discord bot designed to enhance your server with advanced features including moderation tools, invite & message tracking, giveaways, custom welcomer, fun commands, utility features, and much more. Built to make server management effortless and engaging.
`;
---

<Layout title="Jo1nTrX™ - Multipurpose Discord Bot">
    <h1 class="mb-10">Jo1nTrX™ Discord Bot</h1>
    <Markdown content={explainer} class="mb-10 text-lg" />
    
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3 mb-10">
        <div class="p-6 rounded-lg bg-black/50 border border-primary/20">
            <h3 class="text-xl font-bold mb-2 text-primary">🛡️ Moderation</h3>
            <p class="text-sm text-gray-300">Keep your server safe with advanced moderation tools, auto-mod, warnings, and ban management.</p>
        </div>
        <div class="p-6 rounded-lg bg-black/50 border border-primary/20">
            <h3 class="text-xl font-bold mb-2 text-primary">📊 Tracking</h3>
            <p class="text-sm text-gray-300">Track invites, messages, and member activity with detailed analytics and leaderboards.</p>
        </div>
        <div class="p-6 rounded-lg bg-black/50 border border-primary/20">
            <h3 class="text-xl font-bold mb-2 text-primary">🎉 Giveaways</h3>
            <p class="text-sm text-gray-300">Host exciting giveaways with customizable requirements and automatic winner selection.</p>
        </div>
        <div class="p-6 rounded-lg bg-black/50 border border-primary/20">
            <h3 class="text-xl font-bold mb-2 text-primary">👋 Welcomer</h3>
            <p class="text-sm text-gray-300">Greet new members with custom welcome messages, images, and role assignments.</p>
        </div>
        <div class="p-6 rounded-lg bg-black/50 border border-primary/20">
            <h3 class="text-xl font-bold mb-2 text-primary">🎮 Fun Commands</h3>
            <p class="text-sm text-gray-300">Engage your community with games, memes, and entertaining interactive commands.</p>
        </div>
        <div class="p-6 rounded-lg bg-black/50 border border-primary/20">
            <h3 class="text-xl font-bold mb-2 text-primary">⚙️ Utility</h3>
            <p class="text-sm text-gray-300">Essential tools including server info, user lookup, reminders, and much more.</p>
        </div>
    </div>
    
    <p>
        <a href="#invite" class="btn btn-lg sm:min-w-64">Add to Discord</a>
    </p>
</Layout>
